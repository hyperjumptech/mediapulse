{
  "mcpServers": {
    "dataqueue": {
      "command": "npx",
      "args": ["@nicnocquee/dataqueue", "mcp"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "hermes": {
      "command": "pnpm",
      "args": ["--silent", "--filter", "@hermes/mcp-server", "dev"]
    }
  }
}
