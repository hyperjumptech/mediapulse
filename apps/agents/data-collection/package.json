{
  "type": "module",
  "name": "data-collection-agent",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../../packages/env/.env.agents.data-collection -- bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outfile=./dist/server.js --target=bun",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@workspace/agent-auth-client": "workspace:*",
    "@workspace/agent-runtime": "workspace:*",
    "@workspace/agent-types": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/agent-data-api-client": "workspace:*",
    "@workspace/utils": "workspace:*",
    "got": "catalog:",
    "hono": "catalog:",
    "hono-pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@workspace/typescript-config": "workspace:*",
    "dotenv-cli": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
