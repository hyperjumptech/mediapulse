{
  "type": "module",
  "name": "delivery-agent",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ./.env.local -- env PORT=4003 bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outfile=./dist/server.js --target=bun",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@workspace/agent-auth-client": "workspace:*",
    "@workspace/agent-runtime": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/logger": "workspace:*",
    "got": "catalog:",
    "hono": "catalog:",
    "hono-pino": "catalog:",
    "resend": "^6.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@workspace/typescript-config": "workspace:*",
    "dotenv-cli": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
