# Port the agent listens on (default 4010)
PORT=4010

# For local scheduler testing without agent-auth-api: set to true and use any AGENT_API_KEY in hermes-worker.
# Do not use in production.
ALLOW_ANY_BEARER_FOR_LOCAL=true

# When ALLOW_ANY_BEARER_FOR_LOCAL is false, agent-auth-api URL for token verification
# AGENT_AUTH_API_URL=http://localhost:8080

# Optional: when all three are set, agent registers itself with the registry on startup
AGENT_REGISTRY_URL="http://localhost:8082"
AGENT_REGISTRY_API_KEY=
AGENT_PUBLIC_URL="http://localhost:4010"