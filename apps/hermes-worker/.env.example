# hermes-worker environment variables
# Copy packages/env/env.hermes-worker.example here as .env.local and fill in values.
# Required: DATABASE_URL, PG_DATAQUEUE_DATABASE
# For schedule execution: AGENT_API_KEY (create with purpose "scheduler" in API keys UI)
# Optional: AGENT_AUTH_API_URL (for short-lived token flow), REQUIRE_HTTPS_AGENT_ENDPOINTS=true
