# hermes-worker environment variables
# Copy packages/hermes/env/env.hermes-worker.example here as .env.local and fill in values.
# Required: DATABASE_URL, PG_DATAQUEUE_DATABASE
# For schedule execution: HERMES_INTERNAL_API_KEY (same preset as packages/hermes/env/.env) and AGENT_AUTH_API_URL
# Optional: REQUIRE_HTTPS_AGENT_ENDPOINTS=true
