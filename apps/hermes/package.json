{
  "name": "hermes",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "route-action-gen",
    "migrate-dataqueue": "dataqueue-cli migrate",
    "dev": "pnpm generate && pnpm migrate-dataqueue:dev && next dev --turbopack -p 3001",
    "migrate-dataqueue:dev": "dataqueue-cli migrate --envPath .env.local --schema dataqueue --verbose",
    "build": "pnpm generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type:check": "tsc --noEmit",
    "create:route": "route-action-gen create",
    "test": "pnpm generate && vitest --run",
    "test:coverage": "pnpm generate && vitest --run --coverage"
  },
  "dependencies": {
    "@next/env": "catalog:",
    "@nicnocquee/dataqueue": "^1.36.0",
    "@workspace/database": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/idx-tickers-importer": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/ui": "workspace:*",
    "bcrypt": "catalog:",
    "cron-parser": "^5.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "catalog:",
    "got": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "route-action-gen": "catalog:",
    "sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  }
}
