{
  "type": "object",
  "properties": {
    "openaiApiKey": {
      "type": "string",
      "minLength": 1
    },
    "openaiModel": {
      "type": "string",
      "minLength": 1,
      "default": "gpt-4o-mini"
    },
    "queryCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "default": 10
    },
    "languageQuotas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": ["language", "share"],
        "additionalProperties": false
      }
    },
    "intentWeights": {
      "type": "object",
      "properties": {
        "breaking": {
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "kg_change": {
          "type": "number",
          "minimum": 0,
          "default": 0.8
        },
        "fundamental": {
          "type": "number",
          "minimum": 0,
          "default": 0.6
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["openaiApiKey"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
