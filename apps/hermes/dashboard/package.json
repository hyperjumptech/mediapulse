{
  "name": "@hermes/dashboard",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "route-action-gen",
    "dev": "pnpm generate && next dev --turbopack -p 3001",
    "build": "pnpm generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "type:check": "tsc --noEmit",
    "create:route": "route-action-gen create",
    "create:admin": "tsx scripts/create-admin.ts",
    "generate-api-key": "tsx scripts/generate-api-key.ts",
    "seed-kg-vocabulary": "tsx scripts/seed-kg-vocabulary.ts",
    "seed-kg-pipelines": "tsx scripts/seed-kg-pipelines.ts",
    "test": "pnpm generate && vitest --run",
    "test:coverage": "pnpm generate && vitest --run --coverage"
  },
  "dependencies": {
    "@next/env": "catalog:",
    "@workspace/agent-auth-client": "workspace:*",
    "@hermes/env": "workspace:*",
    "@hermes/domain-contract": "workspace:*",
    "@hermes/scheduler": "workspace:*",
    "@hermes/step-input-syntax": "workspace:*",
    "@workspace/json-schema-form": "workspace:*",
    "@mediapulse/idx-tickers-importer": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@mediapulse/database": "workspace:*",
    "@hermes/orchestration-database": "workspace:*",
    "@workspace/ui": "workspace:*",
    "bcrypt": "catalog:",
    "date-fns": "^4.1.0",
    "dotenv": "catalog:",
    "got": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "route-action-gen": "catalog:",
    "sonner": "catalog:",
    "zod": "catalog:",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "tsx": "^4",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  }
}
