# Prisma uses this connection string to connect to the PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Example: postgresql://postgres:mypassword@localhost:5432/mydb?schema=public
DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=public # required
DATABASE_CERT_BASE64=

# Port the app listens on (agent-auth-api: 8080, agent-data-api: 8081, agent-registry-api: 8082)
PORT=8080 #number #default

# Log level for the application (info, debug, warn, error)
LOG_LEVEL=info #default

# URL endpoint for communicating with agent-data-api (required for agent-data-api and agents)
AGENT_DATA_API_URL="http://localhost:8081"

# URL of the agent-auth-api service used to verify API keys (required for agent-data-api and agents)
AGENT_AUTH_API_URL="http://localhost:8080"
AGENT_API_KEY=

# Temporary admin credentials
TEMP_ADMIN_USERNAME=admin # required
TEMP_ADMIN_PASSWORD=adminadmin # required

# Outlook / Microsoft Graph (for outlook-inbox scripts and apps using shared mailbox)
# Azure AD app (client) ID, client secret, tenant ID from app registration. Read /http://localhost:3000/packages/outlook-inbox/microsoft-setup for information on how to get these values.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
# Shared mailbox for app-only: use mailbox email (e.g. shared@domain.com) or Azure AD object ID; omit for "me"
OUTLOOK_USER_ID=

# OpenTelemetry configuration
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="mediapulse"
