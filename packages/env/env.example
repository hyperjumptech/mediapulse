# =============================================================================
# Shared / multi-app variables (used by more than one app; set in root .env or
# per-app .env.local as needed). See dev-docs/docs/production.mdx for details.
# =============================================================================

# Prisma uses this connection string. Used as fallback by all DB packages.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=public # required

# Optional orchestration DB URL override (pipelines, schedules, agent registry, API keys, variables).
# When unset, packages fall back to DATABASE_URL.
ORCHESTRATION_DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=orchestration

# Optional Mediapulse domain DB URL override (tickers, search queries, data sources, newsletters, KG).
# When unset, packages fall back to DATABASE_URL.
MEDIAPULSE_DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=mediapulse

# Max rows per `db:` step-input expansion (take/limit cap). Hermes validation and hermes-worker expansion must use the same value.
HERMES_DATA_SOURCE_MAX_TAKE=5000 #number #default

# Server-side key for AES-256-GCM encryption of registered database connection strings in Hermes.
# Recommended in all environments that use registered databases.
REGISTERED_DATABASE_ENCRYPTION_KEY=
DATABASE_CERT_BASE64=

# Port the app listens on. Used by: agent-auth-api (8080), agent-data-api (8081), agent-registry-api (8082)
PORT=8080 #number #default

# --- Agent data API. Used by: agent-data-api consumers (agents, hermes-worker when storing results) ---
AGENT_DATA_API_URL="http://localhost:8081"

# --- Agent auth API. Used by: agents (verify), hermes-worker (fetch short-lived tokens when set) ---
AGENT_AUTH_API_URL="http://localhost:8080"

# API key for invoking agents. Used by: hermes-worker, Hermes run-pipeline.
# Create a key with purpose "scheduler" in the API keys UI; set it here. When AGENT_AUTH_API_URL is also set,
# the worker uses this key only to call POST /api/token and sends the returned JWT to agents (recommended).
AGENT_API_KEY=

# --- Agent-auth-api only: JWT signing secret for POST /api/token and POST /api/verify. Required for JWT-only invocation. ---
AGENT_AUTH_JWT_SECRET= # optional (required for agent-auth-api in production)

# --- hermes-worker only: set to "true" to reject agent endpoints that use http (non-localhost). ---
REQUIRE_HTTPS_AGENT_ENDPOINTS= # optional

# --- Temporary admin credentials. Used by: agent-auth-api (API key CRUD), Hermes dashboard ---
TEMP_ADMIN_USERNAME=admin # required
TEMP_ADMIN_PASSWORD=adminadmin # required

# Outlook / Microsoft Graph (for outlook-inbox scripts and apps using shared mailbox)
# Azure AD app (client) ID, client secret, tenant ID from app registration. Read /http://localhost:3000/packages/outlook-inbox/microsoft-setup for information on how to get these values.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
# Shared mailbox for app-only: use mailbox email (e.g. shared@domain.com) or Azure AD object ID; omit for "me"
OUTLOOK_USER_ID=
