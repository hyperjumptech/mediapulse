# =============================================================================
# hermes-worker environment variables
# Set these in apps/hermes-worker/.env.local (or your deployment env).
# For schedule execution (invoking agents) you must also set AGENT_API_KEY;
# for the short-lived token flow set AGENT_AUTH_API_URL as well.
# =============================================================================

# Main app database fallback (Prisma).
DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=public # required
# Optional orchestration DB URL override (pipelines, schedules, agent registry, executions).
ORCHESTRATION_DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=orchestration # optional
# Optional Mediapulse domain DB URL override (tickers, data sources, newsletters, KG).
MEDIAPULSE_DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=mediapulse # optional
# Required to decrypt encrypted registered database connection strings.
REGISTERED_DATABASE_ENCRYPTION_KEY= # required
DATABASE_CERT_BASE64=

# DataQueue connection. Same DB OK; use ?schema=dataqueue&search_path=dataqueue. Run migrate-dataqueue before first start.
PG_DATAQUEUE_DATABASE=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=dataqueue&search_path=dataqueue # required

# --- Agent invocation (required for schedule execution; optional here so worker can start without it) ---
# Scheduler API key: create in API keys UI with purpose "scheduler", copy here once.
# If AGENT_AUTH_API_URL is also set, the worker uses this key only to fetch short-lived JWTs from POST /api/token
# and sends those tokens to agents (recommended; revocation in UI stops the worker after token expiry).
AGENT_API_KEY= # optional

# When set, worker fetches short-lived tokens from this URL instead of sending the raw key to agents.
# Use the same base URL as your agent-auth-api (e.g. https://agent-auth-api.yourdomain.com).
AGENT_AUTH_API_URL= # optional

# Set to "true" in production to reject agent endpoints that use http (non-localhost).
REQUIRE_HTTPS_AGENT_ENDPOINTS= # optional

# --- Processor (optional; tune for agent invocation throughput) ---
# Max jobs fetched per poll. Default 10.
PROCESSOR_BATCH_SIZE=10 # optional
# Max concurrent job executions (e.g. agent HTTP calls). Default 3; increase for more parallelism.
PROCESSOR_CONCURRENCY=3 # optional
