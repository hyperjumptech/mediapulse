# Port this agent listens on (ticker-echo: 4010)
PORT=4010 #number #default

# URL of the agent-auth-api service used to verify API keys (optional when ALLOW_ANY_BEARER_FOR_LOCAL=true for local dev only)
AGENT_AUTH_API_URL="http://localhost:8080" # optional

# When true, any Bearer token is accepted (for local scheduler testing without running agent-auth-api). Do not use in production.
ALLOW_ANY_BEARER_FOR_LOCAL=false #default

# Optional: when all three are set, agent registers itself with the registry on startup
AGENT_REGISTRY_URL="http://localhost:8082"
AGENT_REGISTRY_API_KEY=
AGENT_PUBLIC_URL="http://localhost:4010"
