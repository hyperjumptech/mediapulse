# =============================================================================
# Hermes apps (dashboard, agent-auth-api, agent-registry-api, orchestration DB).
# Merged with env.*.example (e.g. env.hermes-worker.example) into .env by
# merge-env-examples.sh. See dev-docs/docs/production.mdx for details.
# =============================================================================

# Node runtime mode (development, production, test). Set by Next.js / Node; used to gate dev-only routes.
NODE_ENV=development #optional

# Hermes orchestration database (pipelines, schedules, users, API keys, agent registry, variables).
# Use a dedicated Postgres database or schema; must match `pnpm --filter @hermes/orchestration-database db:migrate:*` target.
ORCHESTRATION_DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=orchestration #required

# Optional DataQueue database URL for apps that enqueue jobs outside hermes-worker.
# When set, dashboard HTTP trigger invokes enqueue into the same queue DB/schema as worker.
PG_DATAQUEUE_DATABASE=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=dataqueue&search_path=dataqueue #optional

# Max rows per `db:` step-input expansion (take/limit cap). Hermes validation and hermes-worker expansion must use the same value.
HERMES_DATA_SOURCE_MAX_TAKE=5000 #number #default

DATABASE_CERT_BASE64=

# Port the app listens on. Used by: agent-auth-api (8080), agent-registry-api (8082); override per app in deployment.
PORT=8080 #number #default

# --- Agent auth API. Used by: agent-registry-api, Hermes dashboard routes (verify API keys, issue tokens from dashboard) ---
AGENT_AUTH_API_URL="http://localhost:8080" #required

# Shared preset secret for Hermes worker + dashboard to call POST /api/token (same value on worker, dashboard, agent-auth-api).
# Generate once per environment (e.g. openssl rand -base64 32); not stored in the orchestration DB.
HERMES_INTERNAL_API_KEY= #required

# Optional previous Hermes internal key used only during zero-downtime rotation.
# Keep this set temporarily (old key) while apps decrypt old ciphertext and accept legacy Bearer on POST /api/token.
HERMES_INTERNAL_API_KEY_PREVIOUS= #optional

# --- agent-auth-api only: JWT signing secret for POST /api/token and POST /api/verify. Required for JWT-only invocation. ---
AGENT_AUTH_JWT_SECRET= #required

# --- Temporary admin credentials. Used by: agent-auth-api (API key CRUD), Hermes dashboard (pipeline API basic auth) ---
TEMP_ADMIN_USERNAME=admin # required
TEMP_ADMIN_PASSWORD=adminadmin # required

# --- Hermes dashboard: self-service admin password reset (Resend). Base URL must match where the dashboard is reachable (no trailing slash). ---
HERMES_DASHBOARD_PUBLIC_URL=http://localhost:3001 # required default
# Optional: when unset, forgot-password creates a token but skips sending email (local dev). Set for real delivery.
HERMES_RESEND_API_KEY= #optional
# Sender for Resend (required together with HERMES_RESEND_API_KEY to send).
HERMES_RESEND_FROM= #optional

# --- Agent Data API URL for SDK calls from the dashboard ---
AGENT_DATA_API_URL= #optional

# --- Feature flag: CGA diagnostics UI (content-generation-run list & detail pages). Remove after MP-CGA-007 merges. ---
HERMES_CGA_DIAGNOSTICS_ENABLED=false #optional #default

# --- Hermes dashboard MCP API keys: server pepper for SHA-256 hashing at rest (never store plaintext). Generate per environment (e.g. openssl rand -base64 32). ---
HERMES_MCP_API_KEY_PEPPER= #required
