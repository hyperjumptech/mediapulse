# =============================================================================
# Hermes apps (dashboard, agent-auth-api, agent-registry-api, orchestration DB).
# Merged with env.*.example (e.g. env.hermes-worker.example) into .env by
# merge-env-examples.sh. See dev-docs/docs/production.mdx for details.
# =============================================================================

# Hermes orchestration database (pipelines, schedules, users, API keys, agent registry, variables).
# Use a dedicated Postgres database or schema; must match `pnpm --filter @hermes/orchestration-database db:migrate:*` target.
ORCHESTRATION_DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=orchestration #required

# Optional legacy fallback for tools that still read a single URL (prefer ORCHESTRATION_DATABASE_URL).
DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=public #optional

# Max rows per `db:` step-input expansion (take/limit cap). Hermes validation and hermes-worker expansion must use the same value.
HERMES_DATA_SOURCE_MAX_TAKE=5000 #number #default

# Base URL for the Mediapulse domain integration API (Hermes step-input expansion and preview).
MEDIAPULSE_API_URL="http://localhost:8090"

# Bearer token used by Hermes when calling domain integration APIs (set the same value in domain server env).
DOMAIN_INTEGRATION_AUTH_TOKEN=

DATABASE_CERT_BASE64=

# Port the app listens on. Used by: agent-auth-api (8080), agent-registry-api (8082); override per app in deployment.
PORT=8080 #number #default

# --- Agent auth API. Used by: agent-registry-api, Hermes dashboard routes (verify API keys, issue tokens from dashboard) ---
AGENT_AUTH_API_URL="http://localhost:8080"

# API key for invoking agents. Used by: hermes-worker, Hermes run-pipeline / pipeline API.
# Create a key with purpose "scheduler" in the API keys UI; set it here. When AGENT_AUTH_API_URL is also set,
# the worker uses this key only to call POST /api/token and sends the returned JWT to agents (recommended).
AGENT_API_KEY=

# --- agent-auth-api only: JWT signing secret for POST /api/token and POST /api/verify. Required for JWT-only invocation. ---
AGENT_AUTH_JWT_SECRET= # optional (required for agent-auth-api in production)

# --- Temporary admin credentials. Used by: agent-auth-api (API key CRUD), Hermes dashboard (pipeline API basic auth) ---
TEMP_ADMIN_USERNAME=admin # required
TEMP_ADMIN_PASSWORD=adminadmin # required
