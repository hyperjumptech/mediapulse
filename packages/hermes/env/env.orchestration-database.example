# =============================================================================
# @hermes/orchestration-database — minimal variables for Prisma CLI and PrismaClientWithSchema.
# Prisma migrate/generate read ORCHESTRATION_DATABASE_URL from the environment
# (see prisma.config.ts). Runtime client code resolves URL via @hermes/env.
# =============================================================================

# Primary URL for orchestration schema (pipelines, schedules, API keys, agent registry, …).
ORCHESTRATION_DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=orchestration #required

# Optional CA cert (base64) for SSL connections to Postgres.
DATABASE_CERT_BASE64=
