# =============================================================================
# agent-auth-api — minimal variables for apps/hermes/agent-auth-api only.
# Symlink or merge into packages/hermes/env/.env for local dev (see dev-bootstrap).
# Does not include AGENT_AUTH_API_URL (this service is the auth API; it does not call itself).
# =============================================================================

# Orchestration Postgres (API keys, users). Must match @hermes/orchestration-database migrations.
ORCHESTRATION_DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=orchestration #required

# Optional CA cert (base64) when connecting to Postgres with SSL.
DATABASE_CERT_BASE64=

# Listen port (default 8080).
PORT=8080 #number #default

# Preset shared with Hermes dashboard + worker for POST /api/token (Bearer preset).
HERMES_INTERNAL_API_KEY= #required

# HS256 secret for signing/verifying invocation JWTs (POST /api/token, POST /api/verify). Use 32+ chars in production.
AGENT_AUTH_JWT_SECRET= # optional (required for JWT issuance and verification in production)

# Basic auth for admin API routes (API key CRUD).
TEMP_ADMIN_USERNAME=admin # required
TEMP_ADMIN_PASSWORD=adminadmin # required
