generator client {
  provider = "prisma-client"
  output   = "../client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String
  role               UserRole @default(USER)
  isActive           Boolean  @default(true) @map("is_active")
  /// Bumped on password change to invalidate dashboard cookies that embed this version.
  credentialVersion  Int      @default(0) @map("credential_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  variables                           Variable[]
  domainIntegrationsCreated           DomainIntegration[]           @relation("DomainIntegrationCreatedBy")
  agentConfigsCreated                 AgentConfig[]                 @relation("AgentConfigCreatedBy")
  pipelinesCreated                    Pipeline[]                    @relation("PipelineCreatedBy")
  schedulesCreated                    Schedule[]                    @relation("ScheduleCreatedBy")
  httpTriggersCreated                 HttpTrigger[]                 @relation("HttpTriggerCreatedBy")
  pipelineStepsCreated                PipelineStep[]                @relation("PipelineStepCreatedBy")
  dataSourceExpansionTemplatesCreated DataSourceExpansionTemplate[] @relation("DataSourceExpansionTemplateCreatedBy")
  hermesAdminPasswordResetTokens      HermesAdminPasswordResetToken[]
  mcpApiKeysCreated                   McpApiKey[]                   @relation("McpApiKeyCreatedBy")
  mcpApiKeysRevoked                   McpApiKey[]                   @relation("McpApiKeyRevokedBy")

  @@map("user")
}

/// Hashed MCP API key for Hermes dashboard programmatic access (Cursor MCP). Plaintext shown only at creation.
model McpApiKey {
  id                     String    @id @default(uuid())
  label                  String
  /// SHA-256 hex of `HERMES_MCP_API_KEY_PEPPER` concatenated with the raw Bearer token.
  keyHash                String    @unique @map("key_hash")
  readOnly               Boolean   @default(false) @map("read_only")
  createdByUserId        String    @map("created_by_user_id")
  /// Snapshot of owner `User.credentialVersion` at key creation; invalidates key on password reset.
  ownerCredentialVersion Int       @map("owner_credential_version")
  createdAt              DateTime  @default(now()) @map("created_at")
  revokedAt              DateTime? @map("revoked_at")
  revokedByUserId        String?   @map("revoked_by_user_id")
  lastUsedAt             DateTime? @map("last_used_at")

  createdBy User  @relation("McpApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  revokedBy User? @relation("McpApiKeyRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@map("mcp_api_key")
}

/// Single-use token for Hermes dashboard admin self-service password reset (secret stored hashed only).
model HermesAdminPasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  /// SHA-256 hex digest of the raw token from the email link.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("hermes_admin_password_reset_token")
}

enum UserRole {
  ADMIN
  USER
}

model AgentRegistry {
  id                  String   @id @default(uuid())
  agentId             String   @map("agent_id")
  agentVersion        String   @map("agent_version")
  description         String?
  endpoint            Json
  inputSchema         Json?    @map("input_schema")
  configSchema        Json?    @map("config_schema")
  isActive            Boolean  @default(true) @map("is_active")
  domainIntegrationId String   @map("domain_integration_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  domainIntegration DomainIntegration @relation(fields: [domainIntegrationId], references: [id], onDelete: Cascade)

  @@unique([domainIntegrationId, agentId, agentVersion])
  @@map("agent_registry")
}

model AgentConfig {
  id                      String   @id @default(uuid())
  name                    String
  description             String?
  agentId                 String   @map("agent_id")
  agentVersion            String   @map("agent_version")
  config                  Json
  configSchemaFingerprint String?  @map("config_schema_fingerprint")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  createdById             String?  @map("created_by_id")

  createdBy     User?          @relation("AgentConfigCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  pipelineSteps PipelineStep[]

  @@unique([agentId, agentVersion, name])
  @@map("agent_config")
}

model Variable {
  id          String   @id @default(uuid())
  key         String   @unique
  /// Plaintext for non-secret variables. For `is_secret=true`, ciphertext lives on `encryptedPayload`; keep this empty.
  value       String
  note        String?
  isSecret    Boolean  @default(false) @map("is_secret")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")

  createdBy        User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  encryptedPayload EncryptedPayload?

  @@map("variable")
}

enum DomainIntegrationStatus {
  pending
  active
}

/// Hermes-internal encrypted blobs (domain integration API keys, secret variables). At most one parent per row.
model EncryptedPayload {
  id                  String   @id @default(uuid())
  ciphertext          String   @db.Text
  /// SHA-256 hex of the raw domain integration API key; set only for `domain_integration_id` rows (lookup for registration and token mint).
  credentialSha256Hex String?  @unique @map("credential_sha256_hex")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  domainIntegrationId String?            @unique @map("domain_integration_id")
  domainIntegration   DomainIntegration? @relation(fields: [domainIntegrationId], references: [id], onDelete: Cascade)

  variableId String?   @unique @map("variable_id")
  variable   Variable? @relation(fields: [variableId], references: [id], onDelete: Cascade)

  @@map("encrypted_payload")
}

model DomainIntegration {
  id                String                  @id @default(uuid())
  integrationId     String                  @unique @map("integration_id")
  name              String
  baseUrl           String?                 @map("base_url")
  version           String?
  capabilities      Json?                   @default("[]")
  dashboardManifest Json?                   @map("dashboard_manifest")
  isActive          Boolean                 @default(true) @map("is_active")
  isDefault         Boolean                 @default(false) @map("is_default")
  status            DomainIntegrationStatus @default(active)
  createdById       String?                 @map("created_by_id")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  lastSeenAt        DateTime                @default(now()) @map("last_seen_at")

  createdBy                    User?                         @relation("DomainIntegrationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  encryptedPayload             EncryptedPayload?
  agentRegistry                AgentRegistry[]
  pipelines                    Pipeline[]
  dataSourceExpansionTemplates DataSourceExpansionTemplate[]

  @@map("domain_integration")
}

/// Saved `db:…` expansion strings for Hermes UI; scoped to one domain integration.
model DataSourceExpansionTemplate {
  id                  String   @id @default(uuid())
  domainIntegrationId String   @map("domain_integration_id")
  name                String
  expansionString     String   @map("expansion_string")
  description         String?
  createdById         String?  @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  domainIntegration DomainIntegration @relation(fields: [domainIntegrationId], references: [id], onDelete: Cascade)
  createdBy         User?             @relation("DataSourceExpansionTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("data_source_expansion_template")
}

model Pipeline {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  /// Per-agent HTTP request timeout (ms) for invoke_agent jobs; null uses Hermes default (5 minutes).
  timeout             Int?
  isActive            Boolean  @default(true) @map("is_active")
  executionConfig     Json?    @map("execution_config")
  domainIntegrationId String   @map("domain_integration_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdById         String?  @map("created_by_id")

  domainIntegration DomainIntegration         @relation(fields: [domainIntegrationId], references: [id], onDelete: Restrict)
  createdBy         User?                     @relation("PipelineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  steps             PipelineStep[]
  schedules         Schedule[]
  httpTriggers      HttpTrigger[]
  manualExecutions  ManualPipelineExecution[]

  @@map("pipeline")
}

enum HttpTriggerAuthType {
  BEARER_TOKEN
}

enum HttpMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
}

enum ScheduleRepeat {
  once
  repeating
}

/// Outcome of enqueue phase (whether jobs were created/queued as intended).
enum ScheduleEnqueueStatus {
  success
  partial
  failed
}

/// Outcome of run phase (after invocations complete and rollups are computed).
enum ScheduleRunStatus {
  pending
  running
  succeeded
  partial
  failed
  cancelled
}

/// Aggregated outcome for invocations under one pipeline step within a schedule execution.
enum ScheduleStepRollupStatus {
  pending
  running
  success
  partial
  failed
  skipped
  cancelled
}

enum AgentJobExecutionStatus {
  pending
  running
  completed
  failed
  cancelled
}

model Schedule {
  id              String         @id @default(uuid())
  name            String
  description     String?
  repeat          ScheduleRepeat
  cronExpression  String?        @map("cron_expression")
  interval        Int?
  timezone        String         @default("America/New_York")
  startAt         DateTime?      @map("start_at")
  nextRunAt       DateTime?      @map("next_run_at")
  pipelineId      String         @map("pipeline_id")
  retryConfig     Json?          @map("retry_config")
  executionConfig Json?          @map("execution_config")
  priority        Int            @default(0)
  enabled         Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  createdById     String?        @map("created_by")

  createdBy          User?               @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  pipeline           Pipeline            @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  scheduleExecutions ScheduleExecution[]
  agentJobExecutions AgentJobExecution[]

  @@map("schedule")
}

model ScheduleExecution {
  id                       String                @id @default(uuid())
  scheduleId               String                @map("schedule_id")
  executionTime            DateTime              @map("execution_time")
  enqueueStatus            ScheduleEnqueueStatus @map("enqueue_status")
  runStatus                ScheduleRunStatus     @default(pending) @map("run_status")
  effectiveExecutionConfig Json?                 @map("effective_execution_config")
  jobsCreated              Int                   @map("jobs_created")
  jobsEnqueued             Int                   @map("jobs_enqueued")
  succeededInvocationCount Int                   @default(0) @map("succeeded_invocation_count")
  failedInvocationCount    Int                   @default(0) @map("failed_invocation_count")
  errors                   Json?
  metadata                 Json?
  cancelledAt              DateTime?             @map("cancelled_at")
  createdAt                DateTime              @default(now()) @map("created_at")

  schedule               Schedule                @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  agentJobExecutions     AgentJobExecution[]
  scheduleStepExecutions ScheduleStepExecution[]

  @@map("schedule_execution")
}

model AgentJobExecution {
  id                     String                  @id @default(uuid())
  jobId                  String                  @unique @map("job_id")
  agentId                String                  @map("agent_id")
  scheduleId             String?                 @map("schedule_id")
  scheduleExecutionId    String?                 @map("schedule_execution_id")
  httpTriggerId          String?                 @map("http_trigger_id")
  httpTriggerExecutionId String?                 @map("http_trigger_execution_id")
  manualExecutionId      String?                 @map("manual_execution_id")
  pipelineId             String?                 @map("pipeline_id")
  pipelineStepId         String?                 @map("pipeline_step_id")
  status                 AgentJobExecutionStatus
  priority               Int                     @default(0)
  enqueuedAt             DateTime                @map("enqueued_at")
  dependencies           Json?
  params                 Json                    @default("{}")
  /// Resolved step `config` sent with the agent body (stored for execution debugging).
  invocationConfig       Json?                   @map("invocation_config")
  error                  Json?
  /// Parsed agent response envelope (success path or semantic failure): message, details, logs, schemaVersion.
  agentResponse          Json?                   @map("agent_response")
  /// Agent envelope `status` when body was valid: "success" | "failure".
  semanticStatus         String?                 @map("semantic_status")
  startedAt              DateTime?               @map("started_at")
  completedAt            DateTime?               @map("completed_at")
  /// DataQueue `attempts` after the worker claimed this job (refreshed each processing attempt).
  dataQueueAttempts      Int?                    @map("data_queue_attempts")
  /// DataQueue `max_attempts` when last synced (for display, e.g. `3 / 5`).
  dataQueueMaxAttempts   Int?                    @map("data_queue_max_attempts")
  createdAt              DateTime                @default(now()) @map("created_at")

  schedule             Schedule?                @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleExecution    ScheduleExecution?       @relation(fields: [scheduleExecutionId], references: [id], onDelete: SetNull)
  httpTrigger          HttpTrigger?             @relation(fields: [httpTriggerId], references: [id], onDelete: SetNull)
  httpTriggerExecution HttpTriggerExecution?    @relation(fields: [httpTriggerExecutionId], references: [id], onDelete: SetNull)
  manualExecution      ManualPipelineExecution? @relation(fields: [manualExecutionId], references: [id], onDelete: SetNull)

  @@map("agent_job_execution")
}

model HttpTrigger {
  id              String              @id @default(uuid())
  name            String
  description     String?
  pipelineId      String              @map("pipeline_id")
  enabled         Boolean             @default(true)
  method          HttpMethod          @default(POST)
  authType        HttpTriggerAuthType @default(BEARER_TOKEN) @map("auth_type")
  tokenHash       String              @map("token_hash")
  tokenHint       String?             @map("token_hint")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  lastTriggeredAt DateTime?           @map("last_triggered_at")
  createdById     String?             @map("created_by_id")

  createdBy             User?                  @relation("HttpTriggerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  pipeline              Pipeline               @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  agentJobExecutions    AgentJobExecution[]
  httpTriggerExecutions HttpTriggerExecution[]

  @@map("http_trigger")
}

model HttpTriggerExecution {
  id                       String                @id @default(uuid())
  httpTriggerId            String                @map("http_trigger_id")
  executionTime            DateTime              @map("execution_time")
  enqueueStatus            ScheduleEnqueueStatus @map("enqueue_status")
  runStatus                ScheduleRunStatus     @default(pending) @map("run_status")
  effectiveExecutionConfig Json?                 @map("effective_execution_config")
  jobsCreated              Int                   @map("jobs_created")
  jobsEnqueued             Int                   @map("jobs_enqueued")
  succeededInvocationCount Int                   @default(0) @map("succeeded_invocation_count")
  failedInvocationCount    Int                   @default(0) @map("failed_invocation_count")
  errors                   Json?
  metadata                 Json?
  cancelledAt              DateTime?             @map("cancelled_at")
  createdAt                DateTime              @default(now()) @map("created_at")

  httpTrigger               HttpTrigger                @relation(fields: [httpTriggerId], references: [id], onDelete: Cascade)
  agentJobExecutions        AgentJobExecution[]
  httpTriggerStepExecutions HttpTriggerStepExecution[]

  @@map("http_trigger_execution")
}

model HttpTriggerStepExecution {
  id                      String                   @id @default(uuid())
  httpTriggerExecutionId  String                   @map("http_trigger_execution_id")
  pipelineStepId          String                   @map("pipeline_step_id")
  expectedInvocationCount Int                      @map("expected_invocation_count")
  succeededCount          Int                      @default(0) @map("succeeded_count")
  failedCount             Int                      @default(0) @map("failed_count")
  rollupStatus            ScheduleStepRollupStatus @default(pending) @map("rollup_status")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  httpTriggerExecution HttpTriggerExecution @relation(fields: [httpTriggerExecutionId], references: [id], onDelete: Cascade)
  pipelineStep         PipelineStep         @relation(fields: [pipelineStepId], references: [id], onDelete: Cascade)

  @@unique([httpTriggerExecutionId, pipelineStepId])
  @@map("http_trigger_step_execution")
}

model ManualPipelineExecution {
  id                       String                @id @default(uuid())
  pipelineId               String                @map("pipeline_id")
  executionTime            DateTime              @map("execution_time")
  enqueueStatus            ScheduleEnqueueStatus @map("enqueue_status")
  runStatus                ScheduleRunStatus     @default(pending) @map("run_status")
  effectiveExecutionConfig Json?                 @map("effective_execution_config")
  jobsCreated              Int                   @map("jobs_created")
  jobsEnqueued             Int                   @map("jobs_enqueued")
  succeededInvocationCount Int                   @default(0) @map("succeeded_invocation_count")
  failedInvocationCount    Int                   @default(0) @map("failed_invocation_count")
  errors                   Json?
  metadata                 Json?
  cancelledAt              DateTime?             @map("cancelled_at")
  createdAt                DateTime              @default(now()) @map("created_at")

  pipeline                     Pipeline                      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  agentJobExecutions           AgentJobExecution[]
  manualPipelineStepExecutions ManualPipelineStepExecution[]

  @@map("manual_pipeline_execution")
}

model ManualPipelineStepExecution {
  id                      String                   @id @default(uuid())
  manualExecutionId       String                   @map("manual_execution_id")
  pipelineStepId          String                   @map("pipeline_step_id")
  expectedInvocationCount Int                      @map("expected_invocation_count")
  succeededCount          Int                      @default(0) @map("succeeded_count")
  failedCount             Int                      @default(0) @map("failed_count")
  rollupStatus            ScheduleStepRollupStatus @default(pending) @map("rollup_status")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  manualExecution ManualPipelineExecution @relation(fields: [manualExecutionId], references: [id], onDelete: Cascade)
  pipelineStep    PipelineStep            @relation(fields: [pipelineStepId], references: [id], onDelete: Cascade)

  @@unique([manualExecutionId, pipelineStepId])
  @@map("manual_pipeline_step_execution")
}

model PipelineStep {
  id            String   @id @default(uuid())
  order         Int
  agentId       String   @map("agent_id")
  agentVersion  String   @map("agent_version")
  pipelineId    String   @map("pipeline_id")
  agentConfigId String?  @map("agent_config_id")
  input         Json?    @default("{}")
  config        Json?    @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdById   String?  @map("created_by_id")

  createdBy                    User?                         @relation("PipelineStepCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  pipeline                     Pipeline                      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  agentConfig                  AgentConfig?                  @relation(fields: [agentConfigId], references: [id], onDelete: SetNull)
  scheduleStepExecutions       ScheduleStepExecution[]
  httpTriggerStepExecutions    HttpTriggerStepExecution[]
  manualPipelineStepExecutions ManualPipelineStepExecution[]

  @@unique([pipelineId, order])
  @@map("pipeline_step")
}

/// Per-step rollup for one schedule execution (counters and outcome).
model ScheduleStepExecution {
  id                      String                   @id @default(uuid())
  scheduleExecutionId     String                   @map("schedule_execution_id")
  pipelineStepId          String                   @map("pipeline_step_id")
  expectedInvocationCount Int                      @map("expected_invocation_count")
  succeededCount          Int                      @default(0) @map("succeeded_count")
  failedCount             Int                      @default(0) @map("failed_count")
  rollupStatus            ScheduleStepRollupStatus @default(pending) @map("rollup_status")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  scheduleExecution ScheduleExecution @relation(fields: [scheduleExecutionId], references: [id], onDelete: Cascade)
  pipelineStep      PipelineStep      @relation(fields: [pipelineStepId], references: [id], onDelete: Cascade)

  @@unique([scheduleExecutionId, pipelineStepId])
  @@map("schedule_step_execution")
}
