      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/hermes/dashboard/app/api/**/route.ts",
        "$TURBO_ROOT$/apps/hermes/dashboard/lib/parse-api-page-params.ts",
