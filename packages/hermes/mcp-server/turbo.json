        "$TURBO_ROOT$/apps/hermes/dashboard/app/dashboard/**/actions/*/route.post.config.ts",
        "$TURBO_ROOT$/apps/hermes/dashboard/lib/**/*.ts",
        "!$TURBO_ROOT$/apps/hermes/dashboard/app/**/.generated/**"
      ]
