# Port this agent listens on (query-analysis: 4005)
PORT=4005 #number #default
# URL endpoint for communicating with agent-data-api
AGENT_DATA_API_URL="http://localhost:8081" # required
# URL of the agent-auth-api service (verifies invocation JWTs; required for auto-register minting)
AGENT_AUTH_API_URL="http://localhost:8080" # required

# Optional: auto-register with agent-registry-api on startup. Hermes API key purpose domain_integration (DOMAIN_INTEGRATION_API_KEY).
# Mint JWT via POST /api/token. Per-run calls to agent-data-api use the invocation JWT from Hermes, not this key.
AGENT_REGISTRY_URL="http://localhost:8082" # required
AGENT_PUBLIC_URL="http://localhost:4005" # required
DOMAIN_INTEGRATION_API_KEY= # required
DOMAIN_INTEGRATION_ID=mediapulse # required # default

# OpenAI API key and model settings for LLM generation
OPENAI_API_KEY= # required
OPENAI_MODEL="gpt-4o" # required # default

# Query Analysis global configuration
QUERY_ANALYSIS_QUERY_COUNT=10 #number #default
QUERY_ANALYSIS_ALLOWED_LANGUAGES='["en"]' # required # default
QUERY_ANALYSIS_MIN_DETERMINISTIC_COUNT=3 #number #default
QUERY_ANALYSIS_WEIGHT_BREAKING=0.5 #number #default
QUERY_ANALYSIS_WEIGHT_KG_CHANGE=0.3 #number #default
QUERY_ANALYSIS_WEIGHT_FUNDAMENTAL=0.2 #number #default
QUERY_ANALYSIS_MODEL="gpt-4o" # required # default
QUERY_ANALYSIS_MAX_TOKENS=1000 #number #default
