# Query-analysis agent runtime env
PORT=4005 #number #default
AGENT_DATA_API_URL="http://localhost:8081" #required
AGENT_AUTH_API_URL="http://localhost:8080" #required
AGENT_REGISTRY_URL="http://localhost:8082"
AGENT_PUBLIC_URL="http://localhost:4005"
DOMAIN_INTEGRATION_API_KEY=
DOMAIN_INTEGRATION_ID=mediapulse
OPENAI_API_KEY= #required
OPENAI_MODEL=gpt-4o-mini
QUERY_ANALYSIS_QUERY_COUNT=10 #number #default
QUERY_ANALYSIS_ALLOWED_LANGUAGES='["en"]'
QUERY_ANALYSIS_MIN_DETERMINISTIC_COUNT=4 #number #default
QUERY_ANALYSIS_WEIGHT_BREAKING=1 #number #default
QUERY_ANALYSIS_WEIGHT_KG_CHANGE=0.8 #number #default
QUERY_ANALYSIS_WEIGHT_FUNDAMENTAL=0.6 #number #default
QUERY_ANALYSIS_MAX_TOKENS=800 #number
