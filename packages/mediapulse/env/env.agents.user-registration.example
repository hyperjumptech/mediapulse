# Port this agent listens on (user-registration: 4004)
PORT=4004 #number #default

# URL endpoint for communicating with agent-data-api
AGENT_DATA_API_URL="http://localhost:8081" # required

# URL of the agent-auth-api service (verifies invocation JWTs; required for auto-register minting)
AGENT_AUTH_API_URL="http://localhost:8080" # required

# Auto-register with agent-registry-api on startup. All of the following must be non-empty.
# Mint JWT via POST /api/token. Per-run calls to agent-data-api use the invocation JWT from Hermes, not this key.
AGENT_REGISTRY_URL="http://localhost:8082" # required
AGENT_PUBLIC_URL="http://localhost:4004" # required
DOMAIN_INTEGRATION_API_KEY= # required — same as Hermes / domain integration API key
DOMAIN_INTEGRATION_ID=mediapulse # required # default

# Resend: supplied only via Hermes pipeline `config` (resendApiKey, resendSender), not env.

# Outlook / Graph (Hermes agent config supplies these per deployment)
OUTLOOK_CLIENT_ID=client_id
OUTLOOK_CLIENT_SECRET=client_secret
OUTLOOK_TENANT_ID=tenant_id
OUTLOOK_USER_ID=mediapulse@onmicrosoft.com
