# Port this agent listens on (article-analysis: 4011)
PORT=4011 #number #default

# URL endpoint for communicating with agent-data-api
AGENT_DATA_API_URL="http://localhost:8081" # required

# URL of the agent-auth-api service used to verify API keys (optional when ALLOW_ANY_BEARER_FOR_LOCAL=true for local dev only)
AGENT_AUTH_API_URL="http://localhost:8080" # required

# When true, any Bearer token is accepted (for local scheduler testing without running agent-auth-api). Do not use in production.
ALLOW_ANY_BEARER_FOR_LOCAL=false #default

# Optional: auto-register with agent-registry-api on startup. Hermes API key purpose domain_integration (DOMAIN_INTEGRATION_API_KEY).
# Mint JWT via POST /api/token.
AGENT_REGISTRY_URL="http://localhost:8082" # required
AGENT_PUBLIC_URL="http://localhost:4011" # required
DOMAIN_INTEGRATION_API_KEY= # required
# Must match the Hermes domain integration id (same as domain-api DOMAIN_INTEGRATION_ID).
DOMAIN_INTEGRATION_ID=mediapulse # required # default
