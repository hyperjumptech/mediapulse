# Next.js user-registration web app (Fly: mediapulse-user-registration, local port 3002)
PORT=3002 #number #optional

# Shown in the registration mailto flow (public)
NEXT_PUBLIC_REGISTRATION_EMAIL=registration@mediapulse.example #required

# Base URL for agent-data-api (ticker list and unsubscribe routes skip bearer auth).
AGENT_DATA_API_URL=http://localhost:8081 #required
