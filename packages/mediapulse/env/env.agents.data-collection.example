# Port this agent listens on (data-collection: 4001)
PORT=4001 #number #default
# URL endpoint for communicating with agent-data-api
AGENT_DATA_API_URL="http://localhost:8081" # required
# URL of the agent-auth-api service (verifies invocation JWTs; required for auto-register minting)
AGENT_AUTH_API_URL="http://localhost:8080" # required

# Optional: auto-register with agent-registry-api on startup. Requires scheduler-purpose AGENT_API_KEY
# (same as hermes-worker; Dashboard → API keys, purpose "scheduler") to mint a JWT via POST /api/token.
# Per-run calls to agent-data-api use the invocation JWT from Hermes, not this key.
AGENT_REGISTRY_URL="http://localhost:8082"
AGENT_PUBLIC_URL="http://localhost:4001"
AGENT_API_KEY=

# Jina AI API Key for Reader API
JINA_API_KEY= # required

SERPER_API_KEY= # required
