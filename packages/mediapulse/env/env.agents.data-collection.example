# Port this agent listens on (data-collection: 4001)
PORT=4001 #number #default
# URL endpoint for communicating with agent-data-api
AGENT_DATA_API_URL="http://localhost:8081" # required
# URL of the agent-auth-api service (verifies invocation JWTs; required for auto-register minting)
AGENT_AUTH_API_URL="http://localhost:8080" # required

# Optional: auto-register with agent-registry-api on startup. Hermes API key purpose domain_integration (DOMAIN_INTEGRATION_API_KEY).
# Mint JWT via POST /api/token. Per-run calls to agent-data-api use the invocation JWT from Hermes, not this key.
AGENT_REGISTRY_URL="http://localhost:8082" # required
AGENT_PUBLIC_URL="http://localhost:4001" # required
DOMAIN_INTEGRATION_API_KEY= # required
DOMAIN_INTEGRATION_ID=mediapulse # required # default