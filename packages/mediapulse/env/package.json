{
  "name": "@mediapulse/env",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/execute-mediapulse-env-build.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:default": "pnpm exec env-to-t3 -i env.example -o src/index.ts",
    "build:agents.data-collection": "pnpm exec env-to-t3 -i env.agents.data-collection.example -o src/agents-data-collection.ts",
    "build:agents.content-generation": "pnpm exec env-to-t3 -i env.agents.content-generation.example -o src/agents-content-generation.ts",
    "build:agents.delivery": "pnpm exec env-to-t3 -i env.agents.delivery.example -o src/agents-delivery.ts",
    "build:agents.query-analysis": "pnpm exec env-to-t3 -i env.agents.query-analysis.example -o src/agents-query-analysis.ts",
    "build:agents.ticker-echo": "pnpm exec env-to-t3 -i env.agents.ticker-echo.example -o src/agents-ticker-echo.ts",
    "build:agents.user-registration": "pnpm exec env-to-t3 -i env.agents.user-registration.example -o src/agents-user-registration.ts",
    "build:app.user-registration": "pnpm exec env-to-t3 -i env.app.user-registration.example -o src/app-user-registration.ts",
    "build:agents.article-analysis": "pnpm exec env-to-t3 -i env.agents.article-analysis.example -o src/agents-article-analysis.ts"
  },
  "exports": {
    "./agents-content-generation": {
      "types": "./src/agents-content-generation.ts",
      "default": "./src/agents-content-generation.ts"
    },
    "./agents-data-collection": {
      "types": "./src/agents-data-collection.ts",
      "default": "./src/agents-data-collection.ts"
    },
    "./agents-delivery": {
      "types": "./src/agents-delivery.ts",
      "default": "./src/agents-delivery.ts"
    },
    "./agents-query-analysis": {
      "types": "./src/agents-query-analysis.ts",
      "default": "./src/agents-query-analysis.ts"
    },
    "./agents-ticker-echo": {
      "types": "./src/agents-ticker-echo.ts",
      "default": "./src/agents-ticker-echo.ts"
    },
    "./agents-user-registration": {
      "types": "./src/agents-user-registration.ts",
      "default": "./src/agents-user-registration.ts"
    },
    "./app-user-registration": {
      "types": "./src/app-user-registration.ts",
      "default": "./src/app-user-registration.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agents-article-analysis": {
      "types": "./src/agents-article-analysis.ts",
      "default": "./src/agents-article-analysis.ts"
    }
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.10.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dotenv-cli": "^7.3.0",
    "env-to-t3": "^0.0.12",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "tsx": "^4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}