{
  "name": "@mediapulse/env",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/execute-mediapulse-env-build.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:default": "MEDIAPULSE_ENV_BUILD_TARGETS=default tsx scripts/execute-mediapulse-env-build.ts",
    "build:agents.data-collection": "MEDIAPULSE_ENV_BUILD_TARGETS=agents.data-collection tsx scripts/execute-mediapulse-env-build.ts",
    "build:agents.content-generation": "MEDIAPULSE_ENV_BUILD_TARGETS=agents.content-generation tsx scripts/execute-mediapulse-env-build.ts",
    "build:agents.delivery": "MEDIAPULSE_ENV_BUILD_TARGETS=agents.delivery tsx scripts/execute-mediapulse-env-build.ts",
    "build:agents.query-analysis": "MEDIAPULSE_ENV_BUILD_TARGETS=agents.query-analysis tsx scripts/execute-mediapulse-env-build.ts",
    "build:agents.ticker-echo": "MEDIAPULSE_ENV_BUILD_TARGETS=agents.ticker-echo tsx scripts/execute-mediapulse-env-build.ts",
    "build:agents.user-registration": "MEDIAPULSE_ENV_BUILD_TARGETS=agents.user-registration tsx scripts/execute-mediapulse-env-build.ts",
    "build:app.user-registration": "MEDIAPULSE_ENV_BUILD_TARGETS=app.user-registration tsx scripts/execute-mediapulse-env-build.ts",
    "build:agents.article-analysis": "MEDIAPULSE_ENV_BUILD_TARGETS=agents.article-analysis tsx scripts/execute-mediapulse-env-build.ts",
    "build:agents.page-collection": "MEDIAPULSE_ENV_BUILD_TARGETS=agents.page-collection tsx scripts/execute-mediapulse-env-build.ts",
    "build:agents.newsletter-feedback": "MEDIAPULSE_ENV_BUILD_TARGETS=agents.newsletter-feedback tsx scripts/execute-mediapulse-env-build.ts",
    "build:agents.knowledge-ingestion": "MEDIAPULSE_ENV_BUILD_TARGETS=agents.knowledge-ingestion tsx scripts/execute-mediapulse-env-build.ts"
  },
  "exports": {
    "./agents-content-generation": {
      "types": "./src/agents-content-generation.ts",
      "default": "./src/agents-content-generation.ts"
    },
    "./agents-data-collection": {
      "types": "./src/agents-data-collection.ts",
      "default": "./src/agents-data-collection.ts"
    },
    "./agents-delivery": {
      "types": "./src/agents-delivery.ts",
      "default": "./src/agents-delivery.ts"
    },
    "./agents-query-analysis": {
      "types": "./src/agents-query-analysis.ts",
      "default": "./src/agents-query-analysis.ts"
    },
    "./agents-ticker-echo": {
      "types": "./src/agents-ticker-echo.ts",
      "default": "./src/agents-ticker-echo.ts"
    },
    "./agents-user-registration": {
      "types": "./src/agents-user-registration.ts",
      "default": "./src/agents-user-registration.ts"
    },
    "./app-user-registration": {
      "types": "./src/app-user-registration.ts",
      "default": "./src/app-user-registration.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agents-article-analysis": {
      "types": "./src/agents-article-analysis.ts",
      "default": "./src/agents-article-analysis.ts"
    },
    "./agents-page-collection": {
      "types": "./src/agents-page-collection.ts",
      "default": "./src/agents-page-collection.ts"
    },
    "./agents-knowledge-ingestion": {
      "types": "./src/agents-knowledge-ingestion.ts",
      "default": "./src/agents-knowledge-ingestion.ts"
    },
    "./agents-newsletter-feedback": {
      "types": "./src/agents-newsletter-feedback.ts",
      "default": "./src/agents-newsletter-feedback.ts"
    }
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dotenv-cli": "^7.3.0",
    "env-to-t3": "^0.0.12",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "tsx": "^4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
