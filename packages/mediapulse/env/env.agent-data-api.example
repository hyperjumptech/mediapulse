# =============================================================================
# agent-data-api — merged into packages/mediapulse/env/.env by merge-env-examples.sh
#
# The delivery routes use @workspace/orchestration-database, which reads process.env
# via @hermes/env. Those variables are required at runtime even though this app also
# uses @mediapulse/env. Use the same values as packages/hermes/env/env.example for
# local development (one Postgres database, orchestration schema).
# =============================================================================

# Hermes orchestration database (users table for delivery; agent registry, etc.).
# Must match `pnpm --filter @workspace/orchestration-database db:migrate:*` target.
ORCHESTRATION_DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=orchestration #required

# Required by @hermes/env schema when orchestration-database loads; same as agent-auth-api / Hermes dashboard.
TEMP_ADMIN_USERNAME=admin #required
TEMP_ADMIN_PASSWORD=adminadmin #required
