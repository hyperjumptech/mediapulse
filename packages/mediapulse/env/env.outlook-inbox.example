# Only for @mediapulse/outlook-inbox local tooling (`pnpm --filter @mediapulse/outlook-inbox run test:lib`).
# Import `env` from `@mediapulse/env/outlook-inbox`. Not part of the default `@mediapulse/env` slice.
# User-registration agents get Outlook credentials from Hermes agent config (`outlookClientId`, etc.), not from these keys.

# Azure AD app (client) ID, client secret, tenant ID from app registration.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
# Shared mailbox for app-only: mailbox email (e.g. shared@domain.com) or Azure AD object ID; omit for "me"
OUTLOOK_USER_ID=
