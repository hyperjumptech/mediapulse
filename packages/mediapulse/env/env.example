# =============================================================================
# Mediapulse apps (domain-api, agent-data-api, mediapulse-database) and scripts
# that import @mediapulse/env. Merged with env.agents.*.example by merge-env-examples.sh.
# See dev-docs/docs/production.mdx for details.
# =============================================================================

# Mediapulse domain database (tickers, search queries, data sources, newsletters, KG, user_ticker).
# Use a dedicated Postgres database or schema; must match `pnpm --filter @workspace/mediapulse-database db:migrate:*` target.
MEDIAPULSE_DATABASE_URL=postgresql://mediapulse:mediapulse@localhost:5432/mediapulse?schema=mediapulse #required

# Max rows per `db:` step-input expansion (align with Hermes `HERMES_DATA_SOURCE_MAX_TAKE`).
HERMES_DATA_SOURCE_MAX_TAKE=5000 #number #default

# Base URL for this domain integration API (Hermes worker and dashboard call this for expansion).
MEDIAPULSE_API_URL="http://localhost:8090"

# Bearer token used by Hermes when calling domain integration APIs (set the same value here and in Hermes env).
DOMAIN_INTEGRATION_AUTH_TOKEN=

# Hermes base URL used by domain-api when self-registering with Hermes.
HERMES_API_URL="http://localhost:3001"

# API key used by domain-api to call Hermes POST /api/domain-integrations/register.
DOMAIN_INTEGRATION_REGISTRATION_API_KEY=

# Domain integration identity metadata used by domain-api during self-registration.
DOMAIN_INTEGRATION_KEY=mediapulse
DOMAIN_INTEGRATION_NAME=Mediapulse
DOMAIN_INTEGRATION_VERSION=

DATABASE_CERT_BASE64=

# Port the app listens on (e.g. domain-api 8090, agent-data-api 8081).
PORT=8090 #number #default

# URL of the agent-auth-api service used to verify API keys (agent-data-api).
AGENT_AUTH_API_URL="http://localhost:8080"

# Outlook / Microsoft Graph (outlook-inbox scripts)
# Azure AD app (client) ID, client secret, tenant ID from app registration.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
# Shared mailbox for app-only: use mailbox email (e.g. shared@domain.com) or Azure AD object ID; omit for "me"
OUTLOOK_USER_ID=
