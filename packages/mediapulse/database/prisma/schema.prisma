generator client {
  provider = "prisma-client"
  output   = "../client"
}

datasource db {
  provider = "postgresql"
}

enum SearchQueryIntent {
  industryPulse
  competitiveLandscape
  dealsAndMovements
  regulatoryPolicyWatch
  disruptorsOrTech
}

enum CollectionGateStatus {
  passed
  failed
}

enum CuratedSourceLinkType {
  page
  listing
}

/// Operator-managed listing URLs for page-collection (RSS, sitemap, or single article).
model CuratedSource {
  id         String                @id @default(uuid())
  name       String?
  listingUrl String                @unique @map("listing_url")
  linkType   CuratedSourceLinkType @default(listing) @map("link_type")
  enabled    Boolean               @default(true)
  maxItems   Int?                  @map("max_items")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  articles              DataSource[]
  collectionUrlOutcomes CollectionUrlOutcome[]

  @@map("curated_source")
}

model DataSource {
  id                   String                @id @default(uuid())
  url                  String
  canonicalUrl         String                @map("canonical_url")
  title                String
  description          String?               @db.Text
  content              String?
  fetchedAt            DateTime?             @map("fetched_at")
  fetchProvider        String?               @map("fetch_provider")
  author               String?
  source               String?
  metadata             Json?
  publishedAt          DateTime?             @map("published_at")
  tickerId             String?               @map("ticker_id")
  searchQueryId        String?               @map("search_query_id")
  curatedSourceId      String?               @map("curated_source_id")
  dataCollectionRunId  String?               @map("data_collection_run_id")
  collectionGateStatus CollectionGateStatus? @map("collection_gate_status")
  collectionGateReason String?               @map("collection_gate_reason")
  analyzedAt           DateTime?             @map("analyzed_at")
  /// Newsletter section assigned by article-analysis 3.0.0; null = rejected / not classified.
  section              String?               @map("section")
  /// Section-fit score 0–1 from article-analysis 3.0.0.
  sectionScore         Float?                @map("section_score")
  /// AI reason for the section choice or rejection from article-analysis 3.0.0.
  sectionReason        String?               @map("section_reason") @db.Text
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  ticker        Ticker?        @relation(fields: [tickerId], references: [id])
  searchQuery   SearchQuery?   @relation(fields: [searchQueryId], references: [id])
  curatedSource CuratedSource? @relation(fields: [curatedSourceId], references: [id], onDelete: SetNull)

  tickerSections         DataSourceTickerSection[]
  fetchEvents            FetchEvent[]
  newsletterCitations    NewsletterCitation[]
  newsletterSectionItems NewsletterSectionItem[]

  @@index([curatedSourceId])
  @@index([collectionGateStatus, analyzedAt])
  @@index([tickerId, section])
  @@index([dataCollectionRunId])
  @@map("data_source")
}

/// Per-(article, ticker) newsletter-section classification produced by article-analysis.
/// Replaces the 1:1 DataSource.section/sectionScore/sectionReason columns so one curated/global
/// article can belong to a different section for each active ticker.
model DataSourceTickerSection {
  id                    String   @id @default(uuid())
  dataSourceId          String   @map("data_source_id")
  tickerId              String   @map("ticker_id")
  /// Newsletter section id; null = classified-but-rejected for this ticker.
  section               String?  @map("section")
  /// Section-fit score 0–1.
  sectionScore          Float?   @map("section_score")
  /// AI reason for the section choice or rejection.
  sectionReason         String?  @map("section_reason") @db.Text
  /// Self-describing snapshot of the per-rule scoring behind sectionScore/sectionReason.
  sectionScoreBreakdown Json?    @map("section_score_breakdown")
  /// Exact article-analysis run that produced this classification; null for pre-provenance rows.
  articleAnalysisRunId  String?  @map("article_analysis_run_id")
  analyzedAt            DateTime @default(now()) @map("analyzed_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  ticker     Ticker     @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@unique([dataSourceId, tickerId])
  @@index([tickerId, section, analyzedAt])
  @@index([articleAnalysisRunId])
  @@map("data_source_ticker_section")
}

/// Negative cache for URLs that recently failed terminally during data collection.
model DeadUrl {
  id            String   @id @default(uuid())
  tickerId      String?  @map("ticker_id")
  url           String   @unique
  errorCategory String   @map("error_category")
  recordedAt    DateTime @default(now()) @map("recorded_at")
  expiresAt     DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("dead_url")
}

/// Shared cache for listing discovery results, keyed by listing URL and shared across tickers.
model ListingDiscoveryCache {
  id         String   @id @default(uuid())
  listingUrl String   @unique @map("listing_url")
  strategy   String
  items      Json
  fetchedAt  DateTime @default(now()) @map("fetched_at")
  expiresAt  DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("listing_discovery_cache")
}

model DiscoverySourceHealth {
  id              String   @id @default(uuid())
  listingUrl      String   @map("listing_url")
  runDate         DateTime @map("run_date") @db.Date
  discovered      Boolean
  itemCount       Int      @map("item_count")
  winningStrategy String?  @map("winning_strategy")
  failureCount    Int      @map("failure_count")
  lastError       String?  @map("last_error")
  computedAt      DateTime @default(now()) @map("computed_at")

  @@unique([listingUrl, runDate])
  @@index([listingUrl, runDate(sort: Desc)])
  @@map("discovery_source_health")
}

model Newsletter {
  id        String   @id @default(uuid())
  subject   String
  content   String
  tickerId  String   @map("ticker_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  model            String? @map("model")
  agentVersion     String? @map("agent_version")
  configVersion    String? @map("config_version")
  promptHash       String? @map("prompt_hash")
  configSnapshotId String? @map("config_snapshot_id")
  promptTokens     Int?    @map("prompt_tokens")
  completionTokens Int?    @map("completion_tokens")
  totalTokens      Int?    @map("total_tokens")
  searchQuerySetId String? @map("search_query_set_id")

  ticker              Ticker                         @relation(fields: [tickerId], references: [id])
  searchQuerySet      SearchQuerySet?                @relation(fields: [searchQuerySetId], references: [id], onDelete: SetNull)
  deliveryCheckpoints NewsletterDeliveryCheckpoint[]
  deliveryRuns        DeliveryRun[]
  feedback            NewsletterFeedback[]
  translations        NewsletterTranslation[]
  citations           NewsletterCitation[]
  sections            NewsletterSection[]

  @@index([searchQuerySetId])
  @@map("newsletter")
}

/// One section of a shipped newsletter as content-generation wrote it: the section's heading and, for
/// a prose section, its summary. The exact grounded structure, persisted at generation time.
model NewsletterSection {
  id           String   @id @default(uuid())
  newsletterId String   @map("newsletter_id")
  sectionKey   String   @map("section_key")
  heading      String
  summary      String?  @db.Text
  position     Int
  createdAt    DateTime @default(now()) @map("created_at")

  newsletter Newsletter              @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  items      NewsletterSectionItem[]

  @@index([newsletterId, position])
  @@map("newsletter_section")
}

/// One written entry (bullet/quick hit) within a `NewsletterSection`: the headline and summary the
/// agent wrote, linked to its source article when the entry cited one.
model NewsletterSectionItem {
  id           String   @id @default(uuid())
  sectionId    String   @map("section_id")
  title        String   @db.Text
  summary      String   @db.Text
  url          String?
  dataSourceId String?  @map("data_source_id")
  position     Int
  createdAt    DateTime @default(now()) @map("created_at")

  section    NewsletterSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  dataSource DataSource?       @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)

  @@index([sectionId, position])
  @@index([dataSourceId])
  @@map("newsletter_section_item")
}

model FetchEvent {
  id           String   @id @default(uuid())
  dataSourceId String   @map("data_source_id")
  tickerId     String   @map("ticker_id")
  reason       String   @db.Text
  provider     String?
  status       String
  createdAt    DateTime @default(now()) @map("created_at")

  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([dataSourceId])
  @@index([tickerId])
  @@map("fetch_event")
}

model NewsletterCitation {
  id           String   @id @default(uuid())
  newsletterId String   @map("newsletter_id")
  dataSourceId String   @map("data_source_id")
  sectionKey   String   @map("section_key")
  createdAt    DateTime @default(now()) @map("created_at")

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([newsletterId, dataSourceId, sectionKey])
  @@index([newsletterId])
  @@index([dataSourceId])
  @@map("newsletter_citation")
}

/// A translated rendering of a Newsletter for a non-English subscription language.
/// The base Newsletter row holds the canonical English text, so delivery checkpoints,
/// the self-describing Message-ID, and feedback correlation all key on the same newsletter id.
model NewsletterTranslation {
  id           String   @id @default(uuid())
  newsletterId String   @map("newsletter_id")
  language     Language
  subject      String
  content      String

  /// Provenance for the translation pass (mirrors Newsletter provenance fields).
  model            String? @map("model")
  promptTokens     Int?    @map("prompt_tokens")
  completionTokens Int?    @map("completion_tokens")
  totalTokens      Int?    @map("total_tokens")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  @@unique([newsletterId, language])
  @@map("newsletter_translation")
}

// NOTE (query-analysis 3.0.0): query provenance removed — carried by intent.
model SearchQuery {
  id        String            @id @default(uuid())
  text      String
  tickerId  String            @map("ticker_id")
  setId     String?           @map("set_id")
  intent    SearchQueryIntent @default(industryPulse)
  rank      Int               @default(1)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  ticker                 Ticker                  @relation(fields: [tickerId], references: [id])
  set                    SearchQuerySet?         @relation(fields: [setId], references: [id], onDelete: SetNull)
  dataSources            DataSource[]
  dataCollectionFailures DataCollectionFailure[]
  searchQueryYields      SearchQueryYield[]

  @@unique([setId, text])
  @@index([tickerId, setId])
  @@map("search_query")
}

/// Daily rollup of articles surfaced per search query via data-collection.
/// Written by data-collection ingestion; read by the query-analysis admin insights provider.
model SearchQueryYield {
  id                String   @id @default(uuid())
  searchQueryId     String   @map("search_query_id")
  runDate           DateTime @map("run_date") @db.Date
  articleCount      Int      @map("article_count")
  novelArticleCount Int      @map("novel_article_count")
  computedAt        DateTime @default(now()) @map("computed_at")

  searchQuery SearchQuery @relation(fields: [searchQueryId], references: [id], onDelete: Cascade)

  @@unique([searchQueryId, runDate])
  @@index([searchQueryId, runDate(sort: Desc)])
  @@map("search_query_yield")
}

model SearchQuerySet {
  id               String   @id @default(uuid())
  tickerId         String   @map("ticker_id")
  generatedAt      DateTime @default(now()) @map("generated_at")
  isActive         Boolean  @default(false) @map("is_active")
  strategySnapshot Json     @map("strategy_snapshot")
  generationSource String   @map("generation_source")
  agentJobId       String?  @map("agent_job_id")
  agentId          String?  @map("agent_id")
  agentVersion     String?  @map("agent_version")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  ticker        Ticker        @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  searchQueries SearchQuery[]
  newsletters   Newsletter[]

  @@index([tickerId, isActive])
  @@map("search_query_set")
}

model Ticker {
  id     String @id @default(uuid())
  symbol String @unique
  name   String

  /// Structured business classification promoted out of the raw IDX blob.
  /// These are the only classification fields code reads; prefer them over `metadataRaw`.
  sector           String?  @map("sector")
  industry         String?  @map("industry")
  subSector        String?  @map("sub_sector")
  subIndustry      String?  @map("sub_industry")
  businessActivity String?  @map("business_activity")
  aliases          String[] @map("aliases")

  /// Full original IDX emiten row. Admin/import display only.
  /// NOTE (query-analysis 3.0.0): code must read the structured columns above, not this blob.
  metadataRaw Json?    @map("metadata_raw")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile         TickerProfile?
  searchQueries   SearchQuery[]
  searchQuerySets SearchQuerySet[]
  dataSources     DataSource[]
  newsletters     Newsletter[]
  userTickers     UserTicker[]

  dataCollectionRuns     DataCollectionRun[]
  dataCollectionFailures DataCollectionFailure[]
  collectionUrlOutcomes  CollectionUrlOutcome[]
  pageCollectionRuns     PageCollectionRun[]
  deliveryRuns           DeliveryRun[]
  contentGenerationRuns  ContentGenerationRun[]
  articleAnalysisRuns    ArticleAnalysisRun[]
  queryAnalysisRuns      QueryAnalysisRun[]
  tickerSections         DataSourceTickerSection[]

  @@map("ticker")
}

model TickerProfile {
  id       String @id @default(uuid())
  tickerId String @unique @map("ticker_id")

  companyOverview   String @map("company_overview")
  businessOperation String @map("business_operation")

  sectorIndonesian      String @map("sector_indonesian")
  sectorEnglish         String @map("sector_english")
  subSectorIndonesian   String @map("sub_sector_indonesian")
  subSectorEnglish      String @map("sub_sector_english")
  industryIndonesian    String @map("industry_indonesian")
  industryEnglish       String @map("industry_english")
  subIndustryIndonesian String @map("sub_industry_indonesian")
  subIndustryEnglish    String @map("sub_industry_english")

  aliases String[] @map("aliases")

  competitors Json
  regulators  Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ticker Ticker @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@map("ticker_profile")
}

/// End-user / newsletter subscriber in the Mediapulse domain (distinct from Hermes orchestration `User` admins).
model MediapulseUser {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  /// When false, the user must not receive newsletters (admin master switch).
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userTickers UserTicker[]
  feedback    NewsletterFeedback[]

  @@map("mediapulse_user")
}

model UserTicker {
  id                      String    @id @default(uuid())
  userId                  String    @map("user_id")
  tickerId                String    @map("ticker_id")
  enabled                 Boolean   @default(true)
  /// Newsletter language for this subscription (en = English, id = Indonesian).
  language                Language  @default(en)
  registrationConfirmedAt DateTime? @map("registration_confirmed_at")
  /// When the user voluntarily unsubscribed (null for admin/manual disables).
  unsubscribedAt          DateTime? @map("unsubscribed_at")
  /// How the user unsubscribed: "link" (GET) or "one_click" (POST). Null for admin/manual.
  unsubscribeMethod       String?   @map("unsubscribe_method")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user                MediapulseUser                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker              Ticker                         @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  deliveryCheckpoints NewsletterDeliveryCheckpoint[]
  feedback            NewsletterFeedback[]

  @@unique([userId, tickerId, language])
  @@map("user_ticker")
}

/// Newsletter delivery language for a subscription (en = English, id = Indonesian).
enum Language {
  en
  id
}

/// Idempotent record that a newsletter was delivered to a subscriber (avoids duplicate sends on job replay).
model NewsletterDeliveryCheckpoint {
  id            String   @id @default(uuid())
  newsletterId  String   @map("newsletter_id")
  userTickerId  String   @map("user_ticker_id")
  deliveredAt   DateTime @default(now()) @map("delivered_at")
  resendEmailId String?  @map("resend_email_id")

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  userTicker UserTicker @relation(fields: [userTickerId], references: [id], onDelete: Cascade)

  @@unique([newsletterId, userTickerId])
  @@map("newsletter_delivery_checkpoint")
}

/// Sentiment label assigned to a newsletter reply by the classifier.
enum FeedbackSentiment {
  positive
  negative
  neutral
  mixed
}

/// Category label assigned to a newsletter reply by the classifier.
enum FeedbackCategory {
  praise
  complaint
  feature_request
  bug
  question
  other
}

/// A reply to a delivered newsletter, captured as raw text and classified by the LLM.
model NewsletterFeedback {
  id             String   @id @default(uuid())
  senderEmail    String   @map("sender_email")
  subject        String?
  rawBody        String   @map("raw_body")
  receivedAt     DateTime @map("received_at")
  /// Outlook Graph message id; unique so re-processing the same reply is idempotent.
  graphMessageId String   @unique @map("graph_message_id")
  /// Raw `In-Reply-To` header value used to correlate the reply to a sent newsletter.
  inReplyTo      String?  @map("in_reply_to")

  sentiment       FeedbackSentiment?
  category        FeedbackCategory?
  classifierModel String?            @map("classifier_model")
  classifiedAt    DateTime?          @map("classified_at")

  userId       String? @map("user_id")
  userTickerId String? @map("user_ticker_id")
  newsletterId String? @map("newsletter_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       MediapulseUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  userTicker UserTicker?     @relation(fields: [userTickerId], references: [id], onDelete: SetNull)
  newsletter Newsletter?     @relation(fields: [newsletterId], references: [id], onDelete: SetNull)

  @@index([senderEmail])
  @@index([newsletterId])
  @@map("newsletter_feedback")
}

enum DeliveryRunOutcome {
  success
  skipped
  failed
  partial_success
  skipped_all_already_delivered
}

enum DeliveryRunStage {
  fetch
  render
  send
  persist_delivery_record
}

enum DeliveryRecipientOutcomeStatus {
  success
  failed
  skipped
}

model DeliveryRun {
  id                    String             @id @default(uuid())
  agentId               String             @map("agent_id")
  agentVersion          String             @map("agent_version")
  tickerId              String             @map("ticker_id")
  newsletterId          String?            @map("newsletter_id")
  outcome               DeliveryRunOutcome
  stage                 DeliveryRunStage?
  successCount          Int                @default(0) @map("success_count")
  failureCount          Int                @default(0) @map("failure_count")
  skippedCount          Int                @default(0) @map("skipped_count")
  durationMs            Int                @map("duration_ms")
  scheduleExecutionId   String?            @map("schedule_execution_id")
  /// Hermes `Schedule.id` from `X-Schedule-Id` (distinct from schedule execution row).
  hermesScheduleId      String?            @map("hermes_schedule_id")
  pipelineStepId        String?            @map("pipeline_step_id")
  jobId                 String?            @map("job_id")
  hermesExecutionId     String?            @map("hermes_execution_id")
  runSkipReason         String?            @map("run_skip_reason")
  resendMessageIds      Json?              @map("resend_message_ids")
  recipientErrorSummary String?            @map("recipient_error_summary")
  createdAt             DateTime           @default(now()) @map("created_at")

  ticker     Ticker                     @relation(fields: [tickerId], references: [id])
  newsletter Newsletter?                @relation(fields: [newsletterId], references: [id], onDelete: SetNull)
  recipients DeliveryRecipientOutcome[]

  @@index([tickerId, createdAt])
  @@index([outcome, createdAt])
  @@map("delivery_run")
}

model DeliveryRecipientOutcome {
  id               String                         @id @default(uuid())
  runId            String                         @map("run_id")
  userTickerId     String                         @map("user_ticker_id")
  status           DeliveryRecipientOutcomeStatus
  attempts         Int                            @default(0)
  lastErrorCode    String?                        @map("last_error_code")
  lastErrorMessage String?                        @map("last_error_message")
  errorCategory    String?                        @map("error_category")
  resendEmailId    String?                        @map("resend_email_id")

  run DeliveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("delivery_recipient_outcome")
}

enum DataCollectionRunStatus {
  success
  partial_success
  failed
}

enum DataCollectionProviderStage {
  web_search @map("web-search")
  web_fetch  @map("web-fetch")
}

enum DataCollectionProvider {
  serper
  jina
  firecrawl
  firecrawl_selfhosted
  diffbot
  tavily
  exa
}

enum DataCollectionErrorCategory {
  network_error
  timeout_error
  provider_http_error
  provider_schema_error
  provider_data_invalid
  internal_processing_error
}

model DataCollectionRun {
  id                  String                  @id @default(uuid())
  tickerId            String?                 @map("ticker_id")
  scheduleExecutionId String?                 @map("schedule_execution_id")
  startedAt           DateTime                @map("started_at")
  completedAt         DateTime?               @map("completed_at")
  status              DataCollectionRunStatus

  snapshot Json?

  ticker   Ticker?                 @relation(fields: [tickerId], references: [id])
  failures DataCollectionFailure[]
  outcomes CollectionUrlOutcome[]

  @@index([scheduleExecutionId])
  @@map("data_collection_run")
}

/// One run of the article-analysis agent. Article analysis has no per-newsletter
/// tie, so the Chronicle aggregates these across a newsletter's lookback window.
model ArticleAnalysisRun {
  id                  String                  @id @default(uuid())
  tickerId            String?                 @map("ticker_id")
  scheduleExecutionId String?                 @map("schedule_execution_id")
  startedAt           DateTime                @map("started_at")
  completedAt         DateTime?               @map("completed_at")
  status              DataCollectionRunStatus

  model            String?
  agentVersion     String? @map("agent_version")
  promptTokens     Int     @default(0) @map("prompt_tokens")
  completionTokens Int     @default(0) @map("completion_tokens")
  reasoningTokens  Int     @default(0) @map("reasoning_tokens")
  totalTokens      Int     @default(0) @map("total_tokens")

  scored     Int     @default(0)
  rejected   Int     @default(0)
  backlog    Int     @default(0)
  stopReason String? @map("stop_reason")
  durationMs Int?    @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at")

  ticker Ticker? @relation(fields: [tickerId], references: [id])

  @@index([tickerId, startedAt])
  @@index([scheduleExecutionId])
  @@map("article_analysis_run")
}

model DataCollectionFailure {
  id       String                      @id @default(uuid())
  runId    String                      @map("run_id")
  tickerId String?                     @map("ticker_id")
  stage    DataCollectionProviderStage
  provider DataCollectionProvider

  searchQueryId String? @map("search_query_id")
  url           String?

  errorCategory DataCollectionErrorCategory @map("error_category")
  retryable     Boolean
  httpStatus    Int?                        @map("http_status")
  message       String
  createdAt     DateTime                    @default(now()) @map("created_at")

  run         DataCollectionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  ticker      Ticker?           @relation(fields: [tickerId], references: [id])
  searchQuery SearchQuery?      @relation(fields: [searchQueryId], references: [id])

  @@map("data_collection_failure")
}

enum CollectionAgent {
  data_collection @map("data-collection")
  page_collection @map("page-collection")
}

enum CollectionUrlStatus {
  collected
  dropped
  failed
}

/// Per-URL outcome record for a single collection agent run, linked to a ScheduleExecution.
model CollectionUrlOutcome {
  id                  String              @id @default(uuid())
  scheduleExecutionId String?             @map("schedule_execution_id")
  runId               String              @map("run_id")
  tickerId            String?             @map("ticker_id")
  agent               CollectionAgent
  status              CollectionUrlStatus

  url             String
  /// Stable machine token (e.g. "relevance_no_match", "freshness_too_old"). Null when collected.
  reason          String?
  /// Human-readable sentence built at the drop moment (e.g. "Published 2019-03-12, older than the 30-day window"). Null when collected.
  reasonDetail    String? @map("reason_detail")
  /// Discovery listing/RSS URL (page-collection) or search query text (data-collection).
  source          String?
  searchQueryId   String? @map("search_query_id")
  curatedSourceId String? @map("curated_source_id")

  createdAt DateTime @default(now()) @map("created_at")

  run           DataCollectionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  ticker        Ticker?           @relation(fields: [tickerId], references: [id])
  curatedSource CuratedSource?    @relation(fields: [curatedSourceId], references: [id], onDelete: SetNull)

  @@index([scheduleExecutionId])
  @@index([runId, status])
  @@index([tickerId, createdAt])
  @@index([curatedSourceId, createdAt])
  @@map("collection_url_outcome")
}

/// One run of the page-collection agent. Parallel to DataCollectionRun; page-collection
/// owns its run and child tables instead of sharing DataCollectionRun via an agent flag.
model PageCollectionRun {
  id                  String                  @id @default(uuid())
  tickerId            String?                 @map("ticker_id")
  scheduleExecutionId String?                 @map("schedule_execution_id")
  startedAt           DateTime                @map("started_at")
  completedAt         DateTime?               @map("completed_at")
  status              DataCollectionRunStatus

  snapshot Json?

  ticker Ticker? @relation(fields: [tickerId], references: [id])

  @@index([scheduleExecutionId])
  @@map("page_collection_run")
}

enum ContentGenerationRunOutcome {
  success
  skipped
  failed
}

enum ContentGenerationRunStage {
  precheck
  llm
  validate
  persist
}

/// Diagnostic record for a single content-generation agent invocation.
model ContentGenerationRun {
  id            String                      @id @default(uuid())
  agentId       String                      @map("agent_id")
  agentVersion  String                      @map("agent_version")
  tickerId      String                      @map("ticker_id")
  outcome       ContentGenerationRunOutcome
  stage         ContentGenerationRunStage?  @map("stage")
  errorCode     String?                     @map("error_code")
  errorCategory String?                     @map("error_category")
  message       String?
  durationMs    Int?                        @map("duration_ms")
  pipelineRunId String?                     @map("pipeline_run_id")
  executionId   String?                     @map("execution_id")
  newsletterId  String?                     @map("newsletter_id")
  /// Observability snapshot attached on the success path (e.g. sectionFill).
  details       Json?
  createdAt     DateTime                    @default(now()) @map("created_at")

  ticker Ticker @relation(fields: [tickerId], references: [id])

  @@index([tickerId, createdAt])
  @@index([outcome, createdAt])
  @@map("content_generation_run")
}

/// Per-run chronicle for query-analysis: each generated query with its include/reject decision and reason.
model QueryAnalysisRun {
  id          String   @id @default(uuid())
  tickerId    String   @map("ticker_id")
  /// hermesCorrelation.executionId — ties the chronicle to the run so you can find its activity.
  executionId String?  @map("execution_id")
  /// Per-query decision log: array of { text, included, reason }.
  queries     Json
  createdAt   DateTime @default(now()) @map("created_at")

  ticker Ticker @relation(fields: [tickerId], references: [id])

  @@index([tickerId, createdAt])
  @@index([executionId])
  @@map("query_analysis_run")
}
