{
  "name": "mediapulse",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "generate": "turbo run generate",
    "gen:agent": "turbo gen agent",
    "dev": "turbo dev",
    "dev:hermes": "turbo dev --filter=@hermes/dashboard",
    "dev:user-registration": "turbo dev --filter=@mediapulse/user-registration",
    "dev:agent-auth-api": "turbo dev --filter=@hermes/agent-auth-api",
    "dev:agent-data-api": "turbo dev --filter=@mediapulse/agent-data-api",
    "dev:agent-registry-api": "turbo dev --filter=@hermes/agent-registry-api",
    "dev:hermes-worker": "turbo dev --filter=@hermes/worker",
    "dev:email-ingest": "turbo dev --filter=email-ingest",
    "lint": "turbo lint",
    "type:check": "turbo run type:check",
    "format": "prettier --write \"apps/**/*.{ts,tsx,md}\" \"packages/**/*.{ts,tsx,md}\" \"*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,md}\" \"packages/**/*.{ts,tsx,md}\" \"*.{ts,tsx,md}\"",
    "deploy": "turbo deploy",
    "docs:dev": "pnpm dlx speed-docs --dev ./dev-docs",
    "docs:build": "pnpm dlx speed-docs ./dev-docs",
    "merge-workspace-coverage": "node scripts/merge-workspace-coverage.mjs",
    "cursor:review": "node scripts/cursor-pr-review.mjs",
    "ai:review": "node scripts/ai-pr-review.mjs",
    "code-quality": "turbo run lint type:check test:coverage && pnpm run merge-workspace-coverage && pnpm run format:check",
    "dev:agent-article-analysis": "turbo dev --filter=@mediapulse/article-analysis"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@turbo/gen": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "netlify-cli": "^23.13.3",
    "prettier": "^3.6.2",
    "speed-docs": "^0.0.22",
    "turbo": "^2.5.5",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "bcrypt",
      "core-js-pure",
      "esbuild",
      "netlify-cli",
      "prisma",
      "sharp",
      "unix-dgram"
    ]
  }
}